# Copy to .env and fill in. `.env` is gitignored: it holds nothing secret in
# this template, but the tunnel key next to it in ./config does.

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED. This host's address on your LAN, so players in the house reach the
# server directly instead of travelling to the relay and back.
# Never 0.0.0.0: that would publish the game port to every interface, which is
# the one thing this template exists to avoid.
# ──────────────────────────────────────────────────────────────────────────────
LAN_BIND_ADDRESS=192.168.1.10

# Name prefix for the containers.
STACK_NAME=game

# The game. Defaults are Minecraft Java; both are pinned by digest in the
# compose file's x-images block, so `git pull` delivers the tested pair.
# GAME_IMAGE_TAG=itzg/minecraft-server:java25
# GAME_IMAGE_VERSION=java25
GAME_PORT=25565
GAME_PROTOCOL=tcp
GAME_TYPE=PAPER
GAME_HEAP=2G

# Resource ceilings. Raise the game's if it is killed under load
# (docker inspect <container> --format '{{.State.OOMKilled}}' says so).
GAME_MEMORY_LIMIT=4g
RELAY_MEMORY_LIMIT=128m

# WireGuard sidecar.
# WIREGUARD_IMAGE_VERSION=1.0.20260223-r0-ls121
PUID=1000
PGID=1000
TZ=Etc/UTC
